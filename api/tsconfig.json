{
  "extends": "../tsconfig.base.json",
  "compilerOptions": {
    "types": [
      "bun-types"
    ],
    "lib": [
      "ES2022",
      "DOM"
    ],
    "noEmit": true,
    "rootDir": "..",
    "paths": {
      "@space/privileged": [
        "../server/.generated/privileged.contract"
      ]
    }
  },
  "include": [
    "./**/*",
    "../server/src/**/*"
  ]
}
