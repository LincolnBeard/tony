# Demo host config — copy to .env (Bun loads .env automatically for
# the standalone server) or set the variables in your host's dashboard
# (Vercel: Project → Settings → Environment Variables).

# Port the standalone server listens on. (Unused on Vercel — functions
# don't listen on ports.)
PORT=4173

# Path of the local SQLite (libsql) database file, relative to the
# repo root (created + migrated automatically on first start).
# Delete the file to reset to the pristine demo seed.
# Only used when DATABASE_URL is unset.
DATABASE_PATH=data/graded-vault.db

# Remote libsql database (Turso) — REQUIRED on Vercel, where there is
# no durable local disk. When DATABASE_URL is set it takes precedence
# over DATABASE_PATH everywhere (standalone server and Vercel
# Function alike).
#
#   DATABASE_URL=libsql://<your-database>-<your-org>.turso.io
#   DATABASE_AUTH_TOKEN=<token from the Turso dashboard>
#
# Create both in the Turso dashboard (free tier): https://turso.tech
# → Databases → Create Database → open it → "Create Token".
# See README → Deploying → Vercel for the exact steps.
DATABASE_URL=
DATABASE_AUTH_TOKEN=
